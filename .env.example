# Local Compose only. Copy to .env, replace the two placeholders, never commit .env.
APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_ORIGIN=http://localhost:8080
POSTGRES_PASSWORD=replace_with_random_local_password
DATABASE_URL=postgres://rbac:replace_with_random_local_password@postgres:5432/rbac?sslmode=disable
COOKIE_SECURE=false
GOOGLE_ENABLED=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
SMTP_TLS_MODE=none
OTP_HMAC_KEY=replace_with_base64_of_32_random_bytes
LOG_LEVEL=info
